
---
interface Props {
  titulo?: string;
  descripcion?: string;
}

const { 
  titulo = "Título de la Sección", 
  descripcion = "Esta sección es una introducción a un nuevo tema." 
} = Astro.props;
---

<header class="section-header">
  <h2 class="section-title">{titulo}</h2>
  <p class="section-description">{descripcion}</p>
</header>