---
// components/HeroCarousel.astro
---

<section class="carousel-wrapper">
  <div id="hero-splide" class="splide" aria-label="Características principales">
    <div class="splide__track">
      <ul class="splide__list">
        <li class="splide__slide">
          <div class="feature-card">
            <div class="icon-container">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-brain-icon lucide-brain"
                ><path d="M12 18V5"></path><path
                  d="M15 13a4.17 4.17 0 0 1-3-4 4.17 4.17 0 0 1-3 4"
                ></path><path d="M17.598 6.5A3 3 0 1 0 12 5a3 3 0 1 0-5.598 1.5"
                ></path><path d="M17.997 5.125a4 4 0 0 1 2.526 5.77"
                ></path><path d="M18 18a4 4 0 0 0 2-7.464"></path><path
                  d="M19.967 17.483A4 4 0 1 1 12 18a4 4 0 1 1-7.967-.517"
                ></path><path d="M6 18a4 4 0 0 1-2-7.464"></path><path
                  d="M6.003 5.125a4 4 0 0 0-2.526 5.77"></path></svg
              >
            </div>
            <h2>Generación por IA</h2>
            <p>
              La IA genera contenido y preguntas de alta calidad al instante,
              ahorrándote tiempo.
            </p>
          </div>
        </li>

        <li class="splide__slide">
          <div class="feature-card">
            <div class="icon-container">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-disc-album-icon lucide-disc-album"
                ><rect width="18" height="18" x="3" y="3" rx="2"></rect><circle
                  cx="12"
                  cy="12"
                  r="5"></circle><path d="M12 12h.01"></path></svg
              >
            </div>
            <h2>Plantillas profesionales</h2>
            <p>
              Usa plantillas prediseñadas. Obtén evaluaciones profesionales y
              consistentes con un clic.
            </p>
          </div>
        </li>

        <li class="splide__slide">
          <div class="feature-card">
            <div class="icon-container">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-leaf-icon lucide-leaf"
                ><path
                  d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"
                ></path><path
                  d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"
                ></path></svg
              >
            </div>
            <h2>Visualiza la dificultad</h2>
            <p>
              Controla la dificultad de cada examen, asegurando que se adapte
              perfectamente al nivel del estudiante.
            </p>
          </div>
        </li>

        <li class="splide__slide">
          <div class="feature-card">
            <div class="icon-container">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-download-icon lucide-download"
                ><path d="M12 15V3"></path><path
                  d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path
                  d="m7 10 5 5 5-5"></path></svg
              >
            </div>
            <h2>distribuye y Descarga</h2>
            <p>
              Descarga en varios formatos o distribuye online fácilmente,
              simplificando toda la logística.
            </p>
          </div>
        </li>

        <li class="splide__slide">
          <div class="feature-card">
            <div class="icon-container">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-circle-chevron-down-icon lucide-circle-chevron-down"
                ><circle cx="12" cy="12" r="10"></circle><path
                  d="m16 10-4 4-4-4"></path></svg
              >
            </div>
            <h2>Integracion sencilla</h2>
            <p>
              Crea y gestiona exámenes perfectos sin complicaciones gracias a
              nuestra interfaz amigable.
            </p>
          </div>
        </li>
        <li class="splide__slide">
          <div class="feature-card">
            <div class="icon-container">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-diamond-icon lucide-diamond"
                ><path
                  d="M2.7 10.3a2.41 2.41 0 0 0 0 3.41l7.59 7.59a2.41 2.41 0 0 0 3.41 0l7.59-7.59a2.41 2.41 0 0 0 0-3.41l-7.59-7.59a2.41 2.41 0 0 0-3.41 0Z"
                ></path></svg
              >
            </div>
            <h2>Diseño intuitivo</h2>
            <p>
              Reduce horas de trabajo manual a solo minutos con automatización
              inteligente
            </p>
          </div>
        </li>
      </ul>
    </div>
  </div>
</section>

<script>
  import Splide from "@splidejs/splide";
  import "@splidejs/splide/css";

  function initCarousel() {
    const carouselElement = document.querySelector("#hero-splide");

    if (
      carouselElement &&
      !carouselElement.classList.contains("is-initialized")
    ) {
      const splide = new Splide("#hero-splide", {
        type: "loop",
        perPage: 3,
        perMove: 1,
        autoplay: true,
        interval: 3500,
        pauseOnHover: true,
        pauseOnFocus: true,
        arrows: true,
        pagination: true,
        gap: "2rem",
        padding: { left: "2rem", right: "2rem" },
        breakpoints: {
          1024: {
            perPage: 2,
            gap: "1.5rem",
            padding: { left: "1rem", right: "1rem" },
          },
          768: {
            perPage: 1,
            gap: "1rem",
            padding: { left: "0.5rem", right: "0.5rem" },
          },
        },
      });

      splide.mount();
    }
  }

  document.addEventListener("astro:page-load", initCarousel);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCarousel);
  } else {
    initCarousel();
  }
</script>
