---
// src/components/TemplatesGallery.astro
interface Template {
  id: string;
  title: string;
  image: string;
  link?: string;
}

interface Props {
  title?: string;
  intro?: string;
  description?: string;
  templates?: Template[];
}

const {
  title = "Plantillas para Exámenes y Prácticas de Examania",
  intro = "Es fácil avanzar en tu plan de evaluación con un examen infalible. Visualízalo y estructúralo rápidamente con las plantillas asistidas por Inteligencia Artificial de la colección Examania.",
  description = "Elige una plantilla diseñada por educadores según el tipo de evaluación y luego personalízala fácilmente con fuentes, formatos y elementos gráficos únicos y claros de nuestra biblioteca. Olvídate de empezar desde cero y céntrate en lo importante: crear preguntas de calidad que nuestra IA te ayudará a generar.",
  templates = [
    {
      id: "1",
      title: "Biology Final Exam",
      image: "/plantilla_01.png",
      link: "/editor/biology",
    },
    {
      id: "2",
      title: "Physics Final Examination",
      image: "/plantilla_02.png",
      link: "/editor/physics",
    },
    {
      id: "3",
      title: "Social Studies Examination",
      image: "/plantilla_03.png",
      link: "/editor/social",
    },
    {
      id: "4",
      title: "Mathematics Final Exam",
      image: "/plantilla_04.png",
      link: "/editor/math",
    },
    {
      id: "5",
      title: "General Biology Final Exam",
      image: "/plantilla_05.png",
      link: "/editor/biology-gen",
    },
    {
      id: "6",
      title: "History Midterm Examination",
      image: "/plantilla_06.png",
      link: "/editor/history",
    },
    {
      id: "7",
      title: "English Literature Exam",
      image: "/plantilla_07.png",
      link: "/editor/english",
    },
    {
      id: "8",
      title: "Chemistry Quiz",
      image: "/plantilla_08.png",
      link: "/editor/chemistry",
    },
  ],
} = Astro.props;
---

<section class="templates-section">
  <div class="templates-container">
    <!-- Encabezado -->
    <div class="templates-header">
      <h2 class="templates-title">{title}</h2>
      <p class="templates-intro">{intro}</p>
      <p class="templates-description">{description}</p>
    </div>

    <!-- Grid de plantillas -->
    <div class="templates-grid">
      {
        templates.map((template) => (
          <div class="template-card" data-template-id={template.id}>
            <div class="template-image-wrapper">
              <img
                src={template.image}
                alt={template.title}
                class="template-image"
                loading="lazy"
              />
              <div class="template-overlay">
                <button class="edit-button" data-link={template.link}>
                  Editar plantilla
                </button>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  function initTemplates() {
    const editButtons = document.querySelectorAll(".edit-button");

    if (!editButtons.length) return;

    editButtons.forEach((button) => {
      button.addEventListener("click", (e) => {
        e.preventDefault();
        // const link = button.getAttribute('data-link');

        // if (link) {
        //   // Redirigir a la página de edición
        //   window.location.href = link;
        // } else {
        //   console.log('Editar plantilla clickeado');
        //   // Aquí puedes agregar otra funcionalidad
        // }
      });
    });
  }

  // Inicializar
  document.addEventListener("astro:page-load", initTemplates);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTemplates);
  } else {
    initTemplates();
  }
</script>
