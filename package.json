{
  "name": "landing-page",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "postcss assets/css/styles/main.css -o assets/css/main.css --watch",
    "build": "postcss assets/css/styles/main.css -o assets/css/main.css --env production",
    "build:js": "echo 'Using native ES modules - no build needed'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,css,html,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,css,html,json,md}\"",
    "prepare": "husky"
  },
  "keywords": [
    "landing-page",
    "ieee",
    "bem"
  ],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.1.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^13.0.2",
    "prettier": "^3.6.2"
  }
